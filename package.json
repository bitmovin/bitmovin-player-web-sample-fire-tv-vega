{
  "name": "@amzn/bitmovinplayerwebsamplekepler",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf build bundle kepler-build assets node_modules package-lock.json dist",
    "build": "npm-run-all compile",
    "compile": "tsc -p tsconfig-build.json",
    "test:snapshot": "jest --colors --updateSnapshot",
    "start": "node node_modules/react-native/local-cli/cli.js start",
