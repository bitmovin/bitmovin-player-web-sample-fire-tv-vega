{
  "name": "@amzn/bitmovinplayerwebsamplekepler",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist",
    "start": "node node_modules/react-native/local-cli/cli.js start",
    "test": "jest --colors ",
    "test:snapshot": "jest --colors --updateSnapshot",
    "lint": "eslint src tst --ext .ts,.tsx",
    "lint:fix": "eslint src tst --ext .ts,.tsx --fix",
    "compile": "tsc -p tsconfig.json",
    "build": "npm run compile",
    "build:release": "react-native build-kepler --build-type Release",
    "build:debug": "react-native build-kepler --build-type Debug",
    "build:app": "npm-run-all build:release build:debug",
    "release": "npm-run-all lint test compile",
    "simulator:start": "kepler device simulator start",
    "simulator:stop": "kepler device simulator stop",
    "fastrefresh:start": "kepler device start-port-forwarding -p 8081 --forward false",
    "fastrefresh:stop": "kepler device stop-port-forwarding -p 8081 --forward false",
    "app:install": "kepler device install-app --dir .",
    "app:launch": "kepler device launch-app",
    "app:build:debug": "kepler build -b Debug && npm run app:install && npm run app:launch",
    "app:build": "kepler build && npm run app:install && npm run app:launch"
  },
  "dependencies": {
    "@amzn/react-native-kepler": "^2.0.1731106252",
    "@amzn/react-native-w3cmedia": "^2.1.24",
    "base-64": "^1.0.0",
    "bitmovin-player": "^8.138.0-beta.17",
    "react": "18.2.0",
    "react-native": "0.72.0",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@amzn/kepler-cli-platform": "^0.13.3",
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@babel/traverse": "7.22.8",
    "@react-native-community/cli": "11.3.2",
    "@react-native/eslint-config": "0.72.2",
    "@react-native/metro-config": "^0.72.6",
    "@testing-library/react-native": "^11.5.4",
    "@types/jest": "^28.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.30.0",
    "babel-jest": "^28.0.0",
    "eslint": "^8.12.0",
    "jest": "^28.0.0",
    "metro-react-native-babel-preset": "^0.76.5",
    "mustache": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.6.2",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^28.0.0",
    "typescript": "4.8.4"
  },
  "kepler": {
    "projectType": "application",
    "appName": "bitmovinplayerwebsamplekepler",
    "targets": [
      "tv"
    ],
    "api": 0.1
  }
}
