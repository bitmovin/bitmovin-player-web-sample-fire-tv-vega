{
  "name": "bitmovinplayerwebsamplevega",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build bundle kepler-build coverage",
    "compile": "tsc -p tsconfig.json",
    "build": "npm-run-all lint:fix test compile",
    "start": "react-native start",
    "test": "jest --colors --coverage --passWithNoTests",
    "test:clearCache": "jest --clearCache",
    "test:snapshot": "jest --colors --updateSnapshot",
    "lint": "eslint src tst --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src tst --ext .ts,.tsx --fix --no-error-on-unmatched-pattern",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "npm-run-all build:release build:debug",
    "simulator:start": "vega virtual-device start",
    "simulator:stop": "vega virtual-device stop",
    "fastrefresh:start": "vega device start-port-forwarding -p 8081 --forward false",
    "fastrefresh:stop": "vega device stop-port-forwarding -p 8081 --forward false",
    "app:install": "vega device install-app --dir .",
    "app:install:debug": "vega device install-app -b Debug --dir .",
    "app:launch": "vega device launch-app",
    "app:build:debug": "run-s build:debug && npm run app:install:debug && npm run app:launch",
    "app:build": "run-s build:release && npm run app:install && npm run app:launch"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "4.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "@xmldom/xmldom": "^0.9.8",
    "base-64": "^1.0.0",
    "bitmovin-player": "8.138.0-beta.28",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0.22.0",
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.28.2",
    "@babel/traverse": "7.28.0",
    "@react-native-community/cli": "11.3.2",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^29.0.1",
    "jest": "^29.6.3",
    "mustache": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "bitmovinplayerwebsamplevega",
    "targets": [
      "tv"
    ],
    "api": 0.1
  }
}
