{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    /*
     * `import X = require(...)` is required for the Bitmovin player modules (see src/BitmovinPlayer.tsx),
     * which `module: "esnext"` from the base config rejects with TS1202. `preserve` permits it and keeps
     * the base's bundler resolution.
     */
    "module": "preserve",

    /* The polyfills widen Node/web globals (`global`, `navigator`), so node types must stay included. */
    "types": ["jest", "node"],

    "noImplicitAny": false
  },
  "include": ["src/**/*", "tst/**/*"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js"]
}
